# WOWS Portal — environment variables
#
# Copy this file to `.env.local` for local development. `.env.local` is
# git-ignored; never commit real values, and never paste them into chat, docs,
# or issue trackers. Vercel holds the production values in Project Settings.
#
# Phase 0 reads NONE of these. Each variable is listed with the phase that
# starts reading it so the shape is known before the code exists. When a
# phase starts reading a variable, move it out of the "planned" block.

# --- Read today ------------------------------------------------------------

# Set automatically by GitHub Actions. Playwright uses it to forbid `test.only`
# and to refuse reusing a stale dev server. Do not set it locally.
# CI=true

# --- Planned: Supabase (Phase 1) --------------------------------------------

# Project URL and publishable ("anon") key. Both are safe to expose to the
# browser; row-level security is what protects data, not secrecy of these.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses row-level security. Server-only: never prefix
# with NEXT_PUBLIC_, never import into a client component.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by the migration tool.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Planned: Sentry (phase pending decision, see docs/phases/phase-0.md) ---

# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
