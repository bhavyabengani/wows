# WOWS Portal — environment variables
#
# Copy this file to `.env.local` for local development; the values below are
# the local Supabase demo values and work unchanged against `npm run db:start`.
# They are NOT secrets and NEVER work in production. Production values live in
# Vercel (Settings > Environment Variables) and GitHub (Settings > Secrets);
# never commit them, never paste them into chat, docs or issues.
#
# Every variable the app reads is validated in src/lib/env.ts at startup.

# --- Database (Drizzle) ---------------------------------------------------------
# Direct / session-mode connection: migrations, seed, tests, backup drill.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Transaction-mode pooler for the running app (Vercel is IPv4-only and must
# use the pooler). Optional locally; falls back to DATABASE_URL.
DATABASE_POOLER_URL=postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres

# --- Supabase Auth --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser. RLS protects data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Secret key: Auth admin API only (seed creates users). Server-only. Never
# committed, not even the local demo value: `npm run db:env` fills it in from
# `supabase status` after `npm run db:start`.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------------
# Used to build the magic-link redirect. Production: https://wows-seven.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sentry (optional; the SDK is inert when blank) -----------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Only on Vercel, for source map upload during `next build`.
# SENTRY_AUTH_TOKEN=

# --- Local testing only -------------------------------------------------------------
# Mailpit inbox where local magic links land; used by the login E2E test.
MAILPIT_URL=http://127.0.0.1:54324
# Set by GitHub Actions; never set locally.
# CI=true
