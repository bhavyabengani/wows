{
  "name": "wows",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,storage-api,postgrest,postgres-meta",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/lib/run-with-env.ts drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "supabase db reset --no-seed && npm run db:migrate && npm run db:seed",
    "db:generate-types": "tsx scripts/generate-types.ts && prettier --write src/db/types.ts",
    "db:bootstrap-core": "tsx scripts/bootstrap-core.ts",
    "test:db": "tsx scripts/lib/run-with-env.ts vitest run --config vitest.db.config.ts",
    "db:restore": "scripts/restore.sh",
    "db:backup-drill": "tsx scripts/lib/run-with-env.ts scripts/backup-drill.sh",
    "db:env": "scripts/local-env.sh",
    "db:load-snapshot": "tsx scripts/lib/run-with-env.ts tsx scripts/load-snapshot.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
